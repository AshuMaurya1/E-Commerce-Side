# TiDB Cloud Serverless (MySQL-compatible)
SPRING_PROFILES_ACTIVE=prod
DB_HOST=<your-tidb-host>
DB_PORT=4000
DB_NAME=shopsphere
DB_USERNAME=<your-tidb-username>
DB_PASSWORD=<your-tidb-password>
DB_USE_SSL=true

# JWT Security (minimum 256-bit / 32+ characters)
JWT_SECRET=<use-a-random-secret-at-least-32-characters>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Admin Seeder
APP_SEED_ADMIN_EMAIL=Ashuakgec2316@gmail.com
APP_SEED_ADMIN_PASSWORD=Ashu@23169043
APP_SEED_SAMPLE_DATA=false

# CORS & Cookies
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Optional payment integration
APP_PAYMENT_SIMULATION_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional image integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_RAZORPAY_KEY_ID=
