# Database
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Security (minimum 256-bit / 32+ chars base64 or hex secret)
JWT_SECRET=change-this-to-a-strong-256-bit-secret-key-for-local-dev-only
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Admin Seeder (local development)
APP_SEED_ADMIN_EMAIL=admin@shopsphere.local
APP_SEED_ADMIN_PASSWORD=Admin@12345
APP_SEED_SAMPLE_DATA=true

# CORS & Cookies
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Razorpay Test Mode
APP_PAYMENT_SIMULATION_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
