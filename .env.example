# Local backend development (application-dev.yml uses an H2 database by default)
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Local-only admin account; replace the password before starting the app
APP_SEED_ADMIN_EMAIL=admin@shopsphere.local
APP_SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
APP_SEED_SAMPLE_DATA=true

# Local frontend
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Local payment simulation. Keep real payment secrets out of this file.
APP_PAYMENT_SIMULATION_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional image storage integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
